# ============================================================================
#  Shorts Factory – תבנית משתני סביבה
#  העתיקו קובץ זה ל-.env וערכו אותו:   cp .env.example .env
#  אל תעלו את הקובץ .env עצמו ל-Git (הוא כבר ב-.gitignore)
# ============================================================================

# [חובה] מפתח API חינמי מ-Groq – https://console.groq.com/keys
GROQ_API_KEY=gsk_הזינו_את_המפתח_שלכם

# [אופציונלי] מודל Groq. ברירת מחדל: llama-3.3-70b-versatile
# מודלים חינמיים נוספים: openai/gpt-oss-120b, openai/gpt-oss-20b,
#                        moonshotai/kimi-k2-instruct, llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile

# [אופציונלי] תיקיית הפלט (ברירת מחדל: output/)
# SHORTS_OUTPUT_DIR=output

# [אופציונלי] שפת הקריינות: iw = עברית, en = אנגלית, ar = ערבית
# SHORTS_TTS_LANG=iw

# [אופציונלי] true כדי להקריא באיטיות
# SHORTS_TTS_SLOW=false

# [אופציונלי] true כדי לדלג על הפקת קבצי השמע
# SHORTS_SKIP_AUDIO=false

# [אופציונלי] מספר הרעיונות שייוצרו (3-8, ברירת מחדל: 5)
# SHORTS_IDEAS_COUNT=5
